{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jev-kit.dev/schemas/agent-review-request-v1.json",
  "title": "Jev Kit Agent Review Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "agent", "event", "action", "context"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "minLength": 1 },
    "agent": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } }
    },
    "event": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1 } }
    },
    "action": {
      "type": "object", "additionalProperties": false, "required": ["tool", "input"],
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "input": {},
        "description": { "type": "string" }
      }
    },
    "context": {
      "type": "object", "additionalProperties": false, "required": ["userMessages", "standingPolicy"],
      "properties": {
        "userMessages": { "type": "array", "items": { "type": "string" } },
        "standingPolicy": { "type": "string", "minLength": 1 },
        "cwd": { "type": "string" }
      }
    }
  }
}
